# API origin: scheme + host + port only. Do not end with /api/auth.
# Vite dev proxy target (optional). Default: http://127.0.0.1:8000
# Docker Compose sets VITE_PROXY_TARGET=http://backend:8000 automatically.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
#
# RECOMMENDED for local dev: leave VITE_API_BASE_URL OUT or empty — the browser calls /status and /api via
# Vite's proxy (no CORS issues). If you set http://localhost:8000 the backend MUST be running
# (otherwise "Failed to fetch") and CORS must allow your UI origin.
# VITE_API_BASE_URL=http://localhost:8000
# Google Identity — Web client ID (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs)
# Authorized JavaScript origins — must match the browser address bar exactly (no path):
#   http://localhost:5173
#   http://127.0.0.1:5173   (only if you open the app with 127.0.0.1)
# Plus your production UI origin (https://...)
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
