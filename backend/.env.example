# Copy to .env and fill in values.

# --- LLM (Google Gemini) ---
# Required for narrative evaluation (strengths, weaknesses, recommendations).
# If unset, the app uses built-in heuristic text instead.
GEMINI_API_KEY=
# Stable text model (see https://ai.google.dev/gemini-api/docs/models/gemini )
GEMINI_MODEL=gemini-2.5-flash
# Other examples: gemini-3-flash-preview, gemini-3.1-flash-lite, gemini-2.5-pro
# There is no "gemini-3.5-flash" — use an exact model code from the docs.

# --- Data collection ---
# Optional GitHub token (higher rate limits for profile/repo fetch)
GITHUB_TOKEN=
