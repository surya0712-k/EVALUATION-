# Copy to .env and fill in values.

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HOST=0.0.0.0
# If something else already listens on 8000, a NEW server will fail to bind; the OLD process keeps serving (often 404 on /api/auth/google). Free the port or change PORT here and VITE_API_BASE_URL on the frontend.
PORT=8000
RELOAD=false
# Include every UI origin you use (Vite dev 5173, preview 4173, production URL). localhost ≠ 127.0.0.1.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AUTH_SECRET=change-this-in-production
# When true, /api/evaluate and /api/reports* require Authorization: Bearer <token> from /api/auth/login
AUTH_REQUIRED=false
# Google Sign-In (same Web client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env)
# GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# --- Database ---
# LOCAL DEV: omit DATABASE_URL entirely to use SQLite at backend/careerlens.db (recommended).
# Or one-off from repo root: $env:FORCE_SQLITE="1"; .\start_backend.ps1  (uses backend/careerlens.db for this run).
# If DATABASE_URL=postgresql://... and Postgres is NOT running, the API crashes on startup and the
# browser shows "Failed to fetch" for http://localhost:8000/status — fix Postgres or remove DATABASE_URL.
#
# SQLite (explicit path):
# DATABASE_URL=C:/path/to/careerlens.db
#
# PostgreSQL (requires running server + pip install psycopg2-binary):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- LinkedIn (also used by MCP: python backend/tools/linkedintool.py) ---
# Apify Console runs use your account; the API server needs the same token here.
# Docker: docker-compose loads this file into the backend container (env_file).
APIFY_API_TOKEN=
# Optional override actor id:
# APIFY_LINKEDIN_ACTOR_ID=harvestapi/linkedin-profile-scraper
# APIFY_TIMEOUT_SECONDS=120
#
# Optional fallback: PhantomBuster automated enrichment.
# PHANTOMBUSTER_API_KEY=
# PHANTOMBUSTER_AGENT_ID=
# PHANTOMBUSTER_MAX_WAIT_SECONDS=35
#
# Static JSON input (see linkedin_phantombuster._from_json_file)
# LINKEDIN_PROFILE_JSON=C:/path/to/profile.json
# Or copy linkedin_profile.example.json → linkedin_profile.json in this folder (auto-loaded, no env).

# --- GitHub ---
# Strongly recommended: commit scanning hits many /repos/.../commits endpoints.
# Also used by the MCP tool: python backend/tools/githubtool.py (see .cursor/mcp.json).
GITHUB_TOKEN=

# Max repos to scan for commits in the last 90 days (rate-limit safety).
# GITHUB_COMMIT_SCAN_MAX_REPOS=35

